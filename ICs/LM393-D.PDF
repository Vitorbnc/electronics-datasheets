         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">LM393 - Low Offset Voltage Dual Comparators</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>s2190c</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">The LM393 series are dual independent precision voltage&#xA;comparators capable of single or split supply operation. These devices&#xA;are designed to permit a common mode rangeâˆ’toâˆ’ground level with&#xA;single supply operation. Input offset voltage specifications as low as&#xA;2.0 mV make this device an excellent selection for many applications&#xA;in consumer, automotive, and industrial electronics.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <xmpMM:DocumentID>uuid:797bf159-971c-43b5-b4a5-917ea26d4633</xmpMM:DocumentID>
         <xmpMM:InstanceID>uuid:6febc409-7799-4ee6-b54d-90ba10ce5a90</xmpMM:InstanceID>
         <illustrator:StartupProfile>Print</illustrator:StartupProfile>
      </rdf:Description>
